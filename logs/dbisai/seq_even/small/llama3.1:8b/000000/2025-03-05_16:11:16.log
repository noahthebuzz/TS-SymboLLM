def reconstruct_sequence(data):
    """
    Reconstruct a complete numerical sequence from a subset of values.
    
    Parameters:
    data (dict): A dictionary where keys are timestamps and values are the corresponding numbers in the sequence.
    
    Returns:
    list: A list containing the complete numerical sequence.
    list: A list containing the timestamps of every single value in the sequence.
    """
    
    # Get the list of timestamps
    timestamps = list(data.keys())
    
    # Get the list of numbers
    numbers = list(data.values())
    
    # Find the difference between consecutive numbers
    diff = numbers[1] - numbers[0]
    
    # Find the difference between consecutive timestamps
    timestamp_diff = timestamps[1] - timestamps[0]
    
    # Calculate the number of missing values
    num_missing = len(timestamps) - 1
    
    # Calculate the missing values
    missing_values = [numbers[0] + i * diff for i in range(1, num_missing + 1)]
    
    # Combine the given numbers and the missing values
    complete_numbers = [numbers[0]] + missing_values + [numbers[-1]]
    
    # Combine the given timestamps and the missing timestamps
    complete_timestamps = [timestamps[0]] + [timestamps[0] + i * timestamp_diff for i in range(1, num_missing + 1)] + [timestamps[-1]]
    
    return complete_numbers, complete_timestamps

data = {
    '14:43:01': 0, 
    '14:43:04': 6, 
    '14:43:07': 12, 
    '14:43:10': 18, 
    '14:43:13': 24, 
    '14:43:16': 30, 
    '14:43:19': 36, 
    '14:43:22': 42, 
    '14:43:25': 48, 
    '14:43:28': 54
}

complete_numbers, complete_timestamps = reconstruct_sequence(data)
print(complete_numbers)
print(complete_timestamps)
