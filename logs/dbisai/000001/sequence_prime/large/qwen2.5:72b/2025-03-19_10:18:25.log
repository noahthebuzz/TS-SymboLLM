```python
import datetime

# Function to generate the series
def generate_series(start_time, end_time, step, a, b, c):
    series = {}
    current_time = start_time
    n = 1
    while current_time <= end_time:
        value = a * n**2 + b * n + c
        series[current_time.strftime('%H:%M:%S')] = value
        current_time += datetime.timedelta(seconds=step)
        n += 1
    return series

# Given data
start_time = datetime.datetime.strptime('09:04:55', '%H:%M:%S')
end_time = datetime.datetime.strptime('09:05:22', '%H:%M:%S')
