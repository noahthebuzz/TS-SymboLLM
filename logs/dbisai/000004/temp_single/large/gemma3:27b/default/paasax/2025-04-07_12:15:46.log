    D -- No Errors --> F{Inspect Cooling System};
    F -- Dust/Fan Issue --> G[Clean Dust/Increase Fan Speed];
    F -- No Issues --> H{Check/Lower Room Temperature};
    G --> I{Temperature Stabilized?};
    H --> I;
    C --> I;
    E --> I;
    I -- Yes --> J[End: Temperature Maintained];
    I -- No --> K{Reapply Thermal Paste?};
    K -- Yes --> I;
    K -- No --> L[Lower Maximum Processor Usage];
    L --> I;
```


