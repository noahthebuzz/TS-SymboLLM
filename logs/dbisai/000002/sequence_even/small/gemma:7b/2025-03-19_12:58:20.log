import datetime

start_time = datetime.datetime(2023, 9, 4, 9, 4, 55)

series = {
    start_time: 0,
    datetime.datetime(2023, 9, 4, 9, 4, 58): 6,
    datetime.datetime(2023, 9, 4, 9, 5, 1): 12,
    # ...
}

# Calculate the step value between each number
step = 6

# Iterate and fill in the missing values
for i in range(1, 10):
    timestamp = start_time + datetime.timedelta(minutes=i * 3)
    series[timestamp] = i * step

# Return the completed series
return series
